# Copy to ha.env (git-ignored). Not built into the image: ./build.py flash puts it on
# the card's boot partition, and the Home Assistant host installs it at boot as
# ~/app/.env, which docker compose reads; see resources/ha_config/compose.yaml for
# the keys. Empty is fine.
# FRIGATE_RTSP_PASSWORD=
# ZIGBEE_DEVICE=/dev/serial/by-id/usb-...
# TZ=Europe/London
