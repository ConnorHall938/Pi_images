#!/usr/bin/env python3
"""Installed by the runner-logs layer. Run by runner-logs.service, as the runner user,
with RUNNER_DIR and RUNNER_LOGS_PORT set by the unit. Serves job logs on 127.0.0.1 to
the kiosk page, which can neither read the runner's files nor download logs itself:

    GET /live?since=<unix time>   output of the step running now, from the runner's
                                  _diag/pages/ (only files written since <since>), as
                                  JSON {"runner", "file", "text", "truncated"}
    GET /job-log?repo=<owner/repo>&job=<id>
                                  a finished job's log, fetched from GitHub with the
                                  request's Authorization header (plain text)

GitHub only has a job's log once the job has finished; until then, the step output is
only in the page files the runner writes before uploading (and deletes after).
"""
import http.client
import http.server
import json
import os
import re
import urllib.parse
from pathlib import Path

RUNNER_DIR = Path(os.environ["RUNNER_DIR"])
PAGES = RUNNER_DIR / "_diag" / "pages"
PORT = int(os.environ.get("RUNNER_LOGS_PORT", "8765"))
LIVE_TAIL = 256 * 1024  # bytes of the current step sent to the page
JOB_TAIL = 2 * 1024 * 1024  # bytes of a finished job's log
REPO = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def runner_name():
    try:
        return json.loads((RUNNER_DIR / ".runner").read_text("utf-8-sig"))["agentName"]
    except (OSError, ValueError, KeyError):
        return None


def tail(data, limit):
    """The last `limit` bytes as text, starting at a whole line."""
    truncated = len(data) > limit
    if truncated:
        data = data[-limit:].split(b"\n", 1)[-1]
    return data.decode("utf-8", "replace").replace("﻿", ""), truncated


def live(since):
    newest, newest_mtime = None, since
    for page in PAGES.glob("*.log"):
        try:
            mtime = page.stat().st_mtime
        except OSError:  # uploaded and deleted since the glob
            continue
        if mtime >= newest_mtime:
            newest, newest_mtime = page, mtime
    text, truncated = "", False
    if newest:
        try:
            with newest.open("rb") as f:
                size = f.seek(0, os.SEEK_END)
                f.seek(max(0, size - LIVE_TAIL - 1))
                text, truncated = tail(f.read(), LIVE_TAIL)
        except OSError:
            newest = None
    return {"runner": runner_name(), "file": newest and newest.name,
            "text": text, "truncated": truncated}


def https_get(url, headers):
    parts = urllib.parse.urlsplit(url)
    conn = http.client.HTTPSConnection(parts.netloc, timeout=60)
    conn.request("GET", parts.path + (f"?{parts.query}" if parts.query else ""),
                 headers={"User-Agent": "runner-logs", **headers})
    return conn.getresponse()


def job_log(repo, job, authorization):
    """(status, text). GitHub answers with a redirect to a signed download link, which
    must be fetched without the token (the storage behind it rejects one)."""
    response = https_get(
        f"https://api.github.com/repos/{repo}/actions/jobs/{job}/logs",
        {"Authorization": authorization, "Accept": "application/vnd.github+json",
         "X-GitHub-Api-Version": "2022-11-28"},
    )
    if response.status in (301, 302, 303, 307, 308):
        location = response.getheader("Location")
        response.close()
        response = https_get(location, {})
    data = response.read()
    if response.status != 200:
        return response.status, data.decode("utf-8", "replace")
    text, truncated = tail(data, JOB_TAIL)
    return 200, ("[earlier output trimmed]\n" if truncated else "") + text


class Handler(http.server.BaseHTTPRequestHandler):
    def send(self, status, body, content_type):
        body = body.encode() if isinstance(body, str) else body
        self.send_response(status)
        # The kiosk page is a file:// page, so every request is cross-origin
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Authorization")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send(204, b"", "text/plain")

    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        query = {k: v[-1] for k, v in urllib.parse.parse_qs(url.query).items()}
        try:
            if url.path == "/live":
                since = float(query.get("since", "0"))
                self.send(200, json.dumps(live(since)), "application/json")
            elif url.path == "/job-log":
                repo, job = query.get("repo", ""), query.get("job", "")
                authorization = self.headers.get("Authorization", "")
                if not REPO.match(repo) or not job.isdigit() or not authorization:
                    self.send(400, "need repo, job and an Authorization header", "text/plain")
                    return
                status, text = job_log(repo, job, authorization)
                self.send(status, text, "text/plain; charset=utf-8")
            else:
                self.send(404, "not found", "text/plain")
        except (OSError, ValueError, http.client.HTTPException) as err:
            self.send(502, f"runner-logs: {err}", "text/plain")

    def log_message(self, format, *args):
        pass  # the page polls every few seconds; errors are sent back instead


if __name__ == "__main__":
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"runner-logs: serving {PAGES} on 127.0.0.1:{PORT}", flush=True)
    server.serve_forever()
